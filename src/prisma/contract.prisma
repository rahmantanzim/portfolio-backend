// use prisma-8

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image       String
  tags        String[]
  link        String   @default("#")
  github      String   @default("#")
  isFeatured  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   temporal.createdAtJsDate()
  updatedAt   temporal.updatedAtJsDate()
}

model Experience {
  id          Int      @id @default(autoincrement())
  role        String
  company     String
  location    String?
  period      String
  description String
  skills      String[]
  order       Int      @default(0)
  createdAt   temporal.createdAtJsDate()
  updatedAt   temporal.updatedAtJsDate()
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt temporal.createdAtJsDate()
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  isAvailable  Boolean  @default(true)
  updatedAt    temporal.updatedAtJsDate()
}